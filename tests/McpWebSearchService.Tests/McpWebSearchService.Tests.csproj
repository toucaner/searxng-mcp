<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Tests are not AOT-compiled; explicitly opt out in case of future Directory.Build.props. -->
    <PublishAot>false</PublishAot>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- AddInMemoryCollection is provided transitively by Microsoft.Extensions.Configuration
         (pulled via the main project's Microsoft.Extensions.Hosting 10.0.9 reference).
         Microsoft.Extensions.Configuration.Memory was folded into the base Configuration package
         starting in .NET 10, so no separate Memory package reference is needed.
         M10 (ADR-033): bumped 10.0.9 -> 10.0.11 to align with Microsoft.AspNetCore.Mvc.Testing 10.0.11,
         which transitively pulls Microsoft.Extensions.Hosting 10.0.11 (NU1605 downgrade error otherwise). -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <!-- M10 (ADR-033): WebApplicationFactory<Program> — boots the real Program.cs in an in-memory TestServer
         for HTTP smoke tests (HttpSmokeTests). Replaces the stdio process-spawn approach of StdioSmokeTests. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\McpWebSearchService\McpWebSearchService.csproj" />
  </ItemGroup>

</Project>