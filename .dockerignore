# .dockerignore — excludes files from Docker build context (COPY . . in Dockerfile)
# ADR-025: reduces context size, avoids stale artifacts and local-only config.

# Build artifacts (regenerated by dotnet publish in build stage).
# Recursive globs: the main project now lives under src/McpWebSearchService/.
**/bin/
**/obj/

# Git history (not needed for build)
.git/

# OpenCode agent workflow config (local-only, gitignored)
.opencode/

# Test project (not compiled in production Docker build; csproj excludes tests/** from main project)
tests/

# Runtime state (debug anti-loop counter)
.test_counter.json

# IDE files
.vs/
.idea/
.vscode/
*.user
*.suo
*.userprefs
*.rsuser

# Logs and temp files
**/*.log
**/*.tmp
**/*.cache

# Docker files (not needed inside the image)
Dockerfile
.dockerignore
docker-compose.yml

# Local runtime config (may contain secrets; not needed in the build context)
.env
.env.*

# Publish output (if local publish was run)
publish/
