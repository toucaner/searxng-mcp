{
  "SearXNG": {
    "BaseUrl": "<url>",
    "MaxResults": 10,
    "BlockedDomains": [ "pinterest.com", "facebook.com" ],
    "DefaultLanguage": "en"
  },
  "CategoryInference": {
    "BaseUrl": "http://127.0.0.1:1234",
    "Model": "qwen3.5-9b",
    "TimeoutSeconds": 20,
    "EnableFallback": true,
    "Categories": [ "it", "news", "science", "images", "videos", "music", "books", "weather", "map", "general" ]
  },
  "McpServer": {
    "Name": "web-search-mcp",
    "Version": "1.0.0",
    "Port": 8080,
    "Path": "/mcp"
  },
  "WazuhLogging": {
    "Enabled": true,
    "Host": "<ip>",
    "Port": 514,
    "AppName": "mcp-web-search"
  },
  "Otlp": {
    "Endpoint": "http://otel-collector:4317"
  }
}
